# Copy to deploy/.env and adjust.

# Image tag to run, e.g. 0.1.1; "latest" follows new releases.
HLSMON_VERSION=latest

# Address and port the web interface and API are published on. The default
# address is the loopback: set 0.0.0.0 to reach the server from other
# hosts directly, or leave it and put a reverse proxy in front.
HLSMON_BIND=127.0.0.1
HLSMON_HTTP_PORT=4000

# First administrator, created when the database is empty. With an empty
# password one is generated and written to the server log once.
HLSMON_ADMIN_USER=admin
HLSMON_ADMIN_PASSWORD=

# Address agents and users reach the server at, when it is behind a
# reverse proxy. Used in the enrollment instructions.
HLSMON_PUBLIC_URL=

# URL prefix, when a reverse proxy publishes the server under one and
# strips it before passing requests on, e.g. /hls-monitor.
HLSMON_BASE_PATH=

# Addresses or CIDRs of reverse proxies whose X-Forwarded-For is trusted.
HLSMON_TRUSTED_PROXIES=

# How long time series are kept.
HLSMON_METRICS_RETENTION=7d

# The segment journal is bounded by count: this many rows per playlist and
# agent, counted apart for ordinary segments and for segments with
# problems; no row is older than the retention, and the journal file never
# exceeds the size limit. Empty means the default (100, 500, 48h, 512).
HLSMON_SEGMENT_KEEP=
HLSMON_SEGMENT_KEEP_PROBLEMS=
HLSMON_SEGMENT_RETENTION=
HLSMON_JOURNAL_MAX_MB=

# How long closed incidents are kept: failures and warnings, and events
# (informational ones). Empty means 2160h and 168h.
HLSMON_INCIDENT_RETENTION=
HLSMON_EVENT_RETENTION=

HLSMON_LOG_LEVEL=info

# Memory. Segment bodies are held in memory while they are checked; all
# checks together hold at most this many MiB of them, and a download waits
# when there is no room (empty means 1024). The container limit should be
# about three times that: parsing takes as much again.
HLSMON_BODY_MEMORY_MB=
HLSMON_MEMORY_LIMIT=3g

# Whether checks may connect to addresses that are not public (loopback,
# private and link-local ranges). same (the default): only for a stream
# whose own address is such; a stream on a public address cannot lead the
# monitor inside by a redirect or by what its playlists name. allow: no
# restriction. deny: never.
HLSMON_PRIVATE_NETWORKS=
# CPU cores the container may use; 0 means no limit.
HLSMON_CPUS=0
